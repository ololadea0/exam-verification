{
  "name": "exam-verification-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install:frontend": "npm install --prefix exam-verification-frontend",
    "install:backend": "npm install --prefix exam-verification-backend",
    "install:all": "npm run install:frontend && npm run install:backend",
    "build": "npm run build --prefix exam-verification-frontend",
    "start": "node exam-verification-backend/server.js"
  }
}
